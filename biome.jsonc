{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "defaultBranch": "main" },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**/*.{ts,js,mjs,tsx,astro,css,json,jsonc,md}", "!**/public", "!**/dist", "!.astro"]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" },
      "style": { "useBlockStatements": "error", "useAsConstAssertion": "error", "noUselessElse": "error" },
      "suspicious": { "noUnknownAtRules": "off", "noDuplicateCustomProperties": "off" },
      "nursery": {
        "useSortedClasses": { "level": "error", "fix": "safe", "options": { "attributes": ["class"], "functions": ["cx"] } }
      }
    }
  },
  "formatter": { "enabled": true, "lineWidth": 130, "indentWidth": 2, "indentStyle": "space" },
  "javascript": {
    "formatter": { "arrowParentheses": "always", "quoteStyle": "double", "semicolons": "always", "trailingCommas": "es5" }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [
    {
      // Biome only sees .astro frontmatter: template usage looks unused to it.
      "includes": ["**/*.astro"],
      "linter": { "rules": { "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" } } }
    }
  ]
}
